pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
#include setup/utilities.lua
#include setup/game.lua
#include ui/ui.lua
#include score/score.lua
#include environment/world.lua
#include ghost/ghost.lua
#include ghost/particles.lua
#include wall/wall.lua

function isGameOver()
	-- Ghost touched the floor
	if ghostIsTouchingFloor() then
		ghostDeath()
		sfx(-2)
		return true
	end

	-- Ghost hit a wall
	for wall in all(WALLS) do
		if ghostIsWallColliding(wall) then
			ghostDeath()
			sfx(-2)
			return true
		end
	end

	-- Ghost still alive
	return false
end

function sceneDraw()
	spr(64, 102, -6, 4, 4)
	-- spr(48, 0 - 1, 80)
	-- spr(49, 8 - 1, 80)
	-- spr(48, 7 - 1, 73)
	-- spr(34, 15 - 1, 73)
	-- spr(18, 15 - 1, 65)
	-- spr(48, 20, 71, 1, 1, true)
	-- spr(48, 27, 78, 1, 1, true)

	-- FLOOR
	for tile = 0, 16, 1 do
		if tile % 2 == 1 then
			spr(68, tile * 8, 112, 1, 1)
			spr(84, tile * 8, 120, 1, 1)
		else
			spr(69, tile * 8, 112, 1, 1)
			spr(85, tile * 8, 120, 1, 1)
		end
	end
end
function windowFrameDraw()
	fillp(0x8124)
	rect(0, 0, 127, 127, COLORS.grey)
	fillp()
end

function gameOverDraw()
	if GAME.over then
		PRINT:inCenter("game over", 64, COLORS.neon_green)
	end
end

-- GAME START -----------------------
function _init()
	-- SETUP

	createGame()
	createScore()
	createWorld()
	createGhost()

	poke(0x5f5c, 255)
	-- Make btnp not repeat
	createWall()
	TIMER.ghost_particle_spawn_time = 0.75
end

function _update60()
	if not GAME.over then
		calculateDeltaTime()
		calculateTimers()
		spawnGhostParticles()
		moveGhostParticles()
		ghostCalculateBehavior()
		ghostCalculateAnimation()
		wallCalculateBehavior()
		scorePoint()
		GAME.over = isGameOver()
	end
end

function _draw()
	cls(COLORS.black)
	sceneDraw()
	wallDraw()
	ghostDraw()
	drawScore()
	drawSkillIcon()
	gameOverDraw()

	-- windowFrameDraw()
	-- ghostDrawHitBox()
end

