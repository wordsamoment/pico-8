pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- UTILITIES -----------------------
PRINT = {
	text_style = "\f0\^w\^t\^y5\^o9ff",
	inCenter = function(self, text, height, color)
		local glyph_width = 8
		local glyph_height = 12
		print(self.text_style .. text, 64 - ((#text * glyph_width) / 2), height - (glyph_height / 2), color)
		-- rect(67, 58, 67 + 8, 58 + 12, COLORS.neon_green)

		-- one letter = 4 px len
	end
}

-- SETUP -----------------------
COLORS = { black = 0, dark_blue = 1, magenta = 2, dark_green = 3, brown = 4, dark_grey = 5, grey = 6, white = 7, red = 8, orange = 9, yellow = 10, neon_green = 11, light_blue = 12, lavender = 13, pink = 14, peach = 15 }
DELTATIME = nil -- global delta time
TIMER = setmetatable({}, { __index = function() return 0 end }) -- Clever countdown timer helper - https://lynn.github.io/blog/pico-timers/

-- FUNCTIONS -----------------------
---- SETUP CALCULATIONS -----------------------
function calculateDeltaTime()
	if (DELTATIME == nil) then
		DELTATIME = 1 / stat(8)
		-- stat(8) = Target FPS in PICO8
	end
end

function calculateTimers()
	for name, time in pairs(TIMER) do
		TIMER[name] = max(0, time - DELTATIME)
		-- minus DELTATIME let's you write seconds as 1 not as 60
		-- added "- DELTATIME" compared to lynn's to achieve this.
	end
end

---- GHOST CALCULATIONS -----------------------
function ghostCalculateBehavior()
	ghostJump()
	ghostFalling()
	ghostWorldBoundaryCollision()
end

-- https://nerdyteachers.com/PICO-8/Collision/101
function ghostWorldBoundaryCollision()
	-- middle number between ceiling, ghost's y and floor (minus the ghost's srite height )
	GHOST.y = mid(WORLD.ceiling, GHOST.y, WORLD.floor - (GHOST.size - 1))
end

function ghostIsTouchingFloor()
	return GHOST.y == WORLD.floor - (GHOST.size - 1)
end

function ghostIsWallColliding(wall)
	if not GHOST.invisible then
		if GHOST.x < wall.x + wall.width
				and GHOST.x + GHOST.size > wall.x
				and GHOST.y < wall.top_part.y + wall.top_part.height
				and GHOST.y + GHOST.size - 1 > wall.top_part.y then
			return true
		elseif GHOST.x < wall.x + wall.width
				and GHOST.x + GHOST.size > wall.x
				and GHOST.y < wall.bottom_part.y + wall.bottom_part.height
				and GHOST.y + GHOST.size - 1 > wall.bottom_part.y then
			return true
		else
			return false
		end
	else
		return false
	end
end

function isGameOver()
	for wall in all(WALLS) do
		if ghostIsWallColliding(wall) then
			sfx(1)
			GHOST.current_sprite = 4
			return true
		end
	end

	if ghostIsTouchingFloor() then
		sfx(1)
		GHOST.current_sprite = 4
		return true
	end

	return false
end

function ghostDrawHitBox()
	rect(GHOST.x, GHOST.y, GHOST.x + GHOST.size, GHOST.y + (GHOST.size - 1))
end

function ghostFalling()
	GHOST.y = GHOST.y - (GHOST.vertical_speed * DELTATIME)
	GHOST.vertical_speed = GHOST.vertical_speed + ((-300 * GAME.speed) * DELTATIME)
end

function ghostJump()
	GHOST.jump_speed = GAME.speed * 90
	if btnp(5) then
		GHOST.vertical_speed = GHOST.jump_speed
		sfx(0)
	end
end

function ghostCalculateAnimation()
	local time_between_sprites = 0.2

	if btnp(5) then
		TIMER.ghost_jumping = 0.25
		GHOST.jumping = true
	end

	if TIMER.ghost_invisible_cooldown == 0 then
		if btnp(4) then
			sfx(2)
			TIMER.ghost_invisible = 2
			GHOST.invisible = true
			TIMER.ghost_invisible_cooldown = 5
		end
	end

	if not GHOST.jumping and not GHOST.invisible then
		GHOST.active_sprite_sheet = 0
	end

	if GHOST.jumping and not GHOST.invisible then
		GHOST.active_sprite_sheet = 2
	end

	if not GHOST.jumping and GHOST.invisible then
		GHOST.active_sprite_sheet = 6
	end

	if GHOST.jumping and GHOST.invisible then
		GHOST.active_sprite_sheet = 8
	end

	if TIMER.ghost_jumping == 0 then
		GHOST.jumping = false
	end

	if TIMER.ghost_invisible == 0 then
		sfx(-2)
		GHOST.invisible = false
	end

	GHOST.current_sprite = flr(((time() / time_between_sprites) % 2) + GHOST.active_sprite_sheet)
end

---- GHOST PARTICLE CALCULATIONS -----------------------
function spawnGhostParticles()
	if TIMER.ghost_particle_spawn_time == 0 then
		add(GHOST_PARTICLES, { x = GHOST.x + 1 - rnd(2), y = GHOST.y + 6 + rnd(2), speed = 0.1, life = 40 })
		TIMER.ghost_particle_spawn_time = 1
	end
end

function moveGhostParticles()
	for particle in all(GHOST_PARTICLES) do
		particle.x -= particle.speed
		particle.y = GHOST.y + 6 + flr(((time() / 0.5) % 2))
		-- this needs a line equation where ghost is 0,0
		-- f(x) = ax+b
		-- f(Ghost.x) = Ghost.y
		particle.life -= 1
		if particle.life < 0 then
			del(GHOST_PARTICLES, particle)
		end
	end
end

function drawGhostParticles()
	for particle in all(GHOST_PARTICLES) do
		pset(particle.x, particle.y, COLORS.grey)
	end
end

---- WALL CALCULATIONS -----------------------
function wallCalculateBehavior()
	moveWall()
	respawnWall()
end

function moveWall()
	for wall in all(WALLS) do
		wall.x -= GAME.speed
	end
end

function respawnWall()
	if WALLS[1].x + WALLS[1].width <= 0 then
		del(WALLS, WALLS[1])
		createWall()
	end
	if WALLS[1].x + WALLS[1].width <= 64 then
		createWall()
	end
end

function createWall()
	if #WALLS < GAME.max_walls then
		local height = rnd(63) + 20
		local wall = {
			x = 128,
			width = 5,
			-- Shared x and width for top and bottom wall
			top_part = { y = WORLD.ceiling, height = height },
			bottom_part = { y = height + GAME.wall_gap, height = WORLD.floor }
		}
		add(WALLS, wall)
	end
end

---- DRAWING -----------------------
function ghostDraw()
	drawGhostParticles()
	spr(GHOST.current_sprite, flr(GHOST.x + 0.5), flr(GHOST.y + 0.5))
end

function wallDraw()
	for wall in all(WALLS) do
		rectfill(flr(wall.x + 0.5), wall.top_part.y, flr(wall.x + 0.5) + wall.width, wall.top_part.y + wall.top_part.height, COLORS.orange)
		rectfill(flr(wall.x + 0.5), wall.bottom_part.y, flr(wall.x + 0.5) + wall.width, wall.bottom_part.y + wall.bottom_part.height, COLORS.orange)
	end
end

function sceneDraw()
	spr(64, 102, -6, 4, 4)
	spr(48, 0 - 1, 80)
	spr(49, 8 - 1, 80)
	spr(48, 7 - 1, 73)
	spr(34, 15 - 1, 73)
	spr(18, 15 - 1, 65)
	spr(48, 20, 71, 1, 1, true)
	spr(48, 27, 78, 1, 1, true)

	-- FLOOR
	for tile = 0, 16, 1 do
		if tile % 2 == 1 then
			spr(68, tile * 8, 112, 1, 1)
			spr(84, tile * 8, 120, 1, 1)
		else
			spr(69, tile * 8, 112, 1, 1)
			spr(85, tile * 8, 120, 1, 1)
		end
	end
end
function windowFrameDraw()
	fillp(0x8124)
	rect(0, 0, 127, 127, COLORS.grey)
	fillp()
end

function gameOverDraw()
	if GAME.over then
		PRINT:inCenter("game over", 64, COLORS.red)
	end
end

-- GAME START -----------------------
function _init()
	-- SETUP
	GAME = { speed = 0.5, wall_gap = 40, max_walls = 2, over = false }
	WORLD = { ceiling = 0, floor = 127 }
	GHOST = { x = 64, y = 50, size = 8, current_sprite = 0, vertical_speed = 0, jump_speed = GAME.speed * 90, active_sprite_sheet = 0, jumping = false, invisible = false }
	GHOST_PARTICLES = {}
	WALLS = {}
	poke(0x5f5c, 255)
	-- Make btnp not repeat
	createWall()
	TIMER.ghost_particle_spawn_time = 0.75
end

function _update60()
	if not GAME.over then
		calculateDeltaTime()
		calculateTimers()
		spawnGhostParticles()
		moveGhostParticles()
		ghostCalculateBehavior()
		ghostCalculateAnimation()
		wallCalculateBehavior()
		GAME.over = isGameOver()
	end

	if GAME.speed < 1.5 then
		GAME.speed += 0.001
	else
		GAME.speed = 1.5
	end
end

function _draw()
	cls(COLORS.black)
	sceneDraw()
	ghostDraw()
	wallDraw()
	gameOverDraw()
	-- windowFrameDraw()
	-- ghostDrawHitBox()
end

