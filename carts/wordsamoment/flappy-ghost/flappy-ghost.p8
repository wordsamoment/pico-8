pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- UTILITIES -----------------------
PRINT = {
	text_style = "\f0\^w\^t\^y5\^o9ff",
	inCenter = function(self, text, height, color)
		local glyph_width = 8
		local glyph_height = 12
		print(self.text_style .. text, 64 - ((#text * glyph_width) / 2), height - (glyph_height / 2), color)
		-- rect(67, 58, 67 + 8, 58 + 12, COLORS.neon_green)

		-- one letter = 4 px len
	end
}

-- SETUP -----------------------
COLORS = { black = 0, dark_blue = 1, magenta = 2, dark_green = 3, brown = 4, dark_grey = 5, grey = 6, white = 7, red = 8, orange = 9, yellow = 10, neon_green = 11, light_blue = 12, lavender = 13, pink = 14, peach = 15 }
DELTATIME = nil -- global delta time
TIMER = setmetatable({}, { __index = function() return 0 end }) -- Clever countdown timer helper - https://lynn.github.io/blog/pico-timers/

-- FUNCTIONS -----------------------
---- SETUP CALCULATIONS -----------------------
function calculateDeltaTime()
	if (DELTATIME == nil) then
		DELTATIME = 1 / stat(8)
		-- stat(8) = Target FPS in PICO8
	end
end

function calculateTimers()
	for name, time in pairs(TIMER) do
		TIMER[name] = max(0, time - DELTATIME)
		-- minus DELTATIME let's you write seconds as 1 not as 60
		-- added "- DELTATIME" compared to lynn's to achieve this.
	end
end

---- GHOST CALCULATIONS -----------------------
function ghostCalculateBehavior()
	ghostJump()
	ghostFalling()
	ghostWorldBoundaryCollision()
end

-- https://nerdyteachers.com/PICO-8/Collision/101
function ghostWorldBoundaryCollision()
	-- middle number between ceiling, ghost's y and floor (minus the ghost's srite height )
	GHOST.y = mid(WORLD.ceiling, GHOST.y, WORLD.floor - (GHOST.size - 1))
end

function ghostIsTouchingFloor()
	return GHOST.y == WORLD.floor - (GHOST.size - 1)
end

function ghostIsWallColliding(wall)
	if GHOST.x < wall.x + wall.width
			and GHOST.x + GHOST.size > wall.x
			and GHOST.y < wall.top_wall.y + wall.top_wall.height
			and GHOST.y + GHOST.size - 1 > wall.top_wall.y then
		return true
	elseif GHOST.x < wall.x + wall.width
			and GHOST.x + GHOST.size > wall.x
			and GHOST.y < wall.bottom_wall.y + wall.bottom_wall.height
			and GHOST.y + GHOST.size - 1 > wall.bottom_wall.y then
		return true
	else
		return false
	end
end

function isGameOver()
	for wall in all(WALLS) do
		if ghostIsWallColliding(wall) then
			GHOST.current_sprite = 4
			return true
		end
	end

	if ghostIsTouchingFloor() then
		GHOST.current_sprite = 4
		return true
	end

	return false
end

function ghostDrawHitBox()
	rect(GHOST.x, GHOST.y, GHOST.x + GHOST.size, GHOST.y + (GHOST.size - 1))
end

function ghostFalling()
	GHOST.y = GHOST.y - (GHOST.vertical_speed * DELTATIME)
	GHOST.vertical_speed = GHOST.vertical_speed + ((-300 * GAME.speed) * DELTATIME)
end

function ghostJump()
	if btnp(5) then
		GHOST.vertical_speed = GHOST.jump_speed
		sfx(0)
	end
end

function ghostCalculateAnimation()
	local time_between_sprites = 0.2
	if btnp(5) then
		TIMER.ghost_animation_sprite_time = 0.25
		GHOST.active_sprite_sheet = 2
	end

	if TIMER.ghost_animation_sprite_time == 0 then
		GHOST.active_sprite_sheet = 0
	end
	GHOST.current_sprite = flr(((time() / time_between_sprites) % 2) + GHOST.active_sprite_sheet)
end

---- WALL CALCULATIONS -----------------------
function wallCalculateBehavior()
	moveWall()
	respawnWall()
end

function moveWall()
	for wall in all(WALLS) do
		wall.x -= GAME.speed
	end
end

function respawnWall()
	if WALLS[1].x + WALLS[1].width <= 0 then
		del(WALLS, WALLS[1])
		createWall()
	end
	if WALLS[1].x + WALLS[1].width <= 64 then
		createWall()
	end
end

function createWall()
	if #WALLS < GAME.max_walls then
		local height = rnd(80) + 20
		local wall = {
			x = 128,
			width = 5,
			-- Shared x and width for top and bottom wall
			top_wall = { y = WORLD.ceiling, height = height },
			bottom_wall = { y = height + GAME.wall_gap, height = WORLD.floor }
		}
		add(WALLS, wall)
	end
end

---- DRAWING -----------------------
function ghostDraw()
	spr(GHOST.current_sprite, flr(GHOST.x + 0.5), flr(GHOST.y + 0.5))
end

function wallDraw()
	for wall in all(WALLS) do
		rectfill(flr(wall.x + 0.5), wall.top_wall.y, flr(wall.x + 0.5) + wall.width, wall.top_wall.y + wall.top_wall.height, COLORS.orange)
		rectfill(flr(wall.x + 0.5), wall.bottom_wall.y, flr(wall.x + 0.5) + wall.width, wall.bottom_wall.y + wall.bottom_wall.height, COLORS.orange)
	end
end

function sceneDraw()
	spr(64, 102, -6, 4, 4)
	spr(48, 0 - 1, 80)
	spr(49, 8 - 1, 80)
	spr(48, 7 - 1, 73)
	spr(34, 15 - 1, 73)
	spr(18, 15 - 1, 65)
	spr(48, 20, 71, 1, 1, true)
	spr(48, 27, 78, 1, 1, true)
end
function windowFrameDraw()
	fillp(0x8124)
	rect(0, 0, 127, 127, COLORS.grey)
	fillp()
end

function gameOverDraw()
	if GAME.over then
		PRINT:inCenter("game over", 64, COLORS.red)
	end
end

-- GAME START -----------------------
function _init()
	-- SETUP
	GAME = { speed = 1, wall_gap = 40, max_walls = 2, over = false }
	WORLD = { ceiling = 0, floor = 127 }
	GHOST = { x = 64, y = 50, size = 8, current_sprite = 0, vertical_speed = 0, jump_speed = GAME.speed * 100, active_sprite_sheet = 0 }
	WALLS = {}

	poke(0x5f5c, 255)
	-- Make btnp not repeat
	createWall()
end

function _update60()
	if not GAME.over then
		calculateTimers()
		calculateDeltaTime()
		ghostCalculateBehavior()
		ghostCalculateAnimation()
		wallCalculateBehavior()
		-- GAME.over = isGameOver()
	end
end

function _draw()
	cls(COLORS.black)
	sceneDraw()
	ghostDraw()
	wallDraw()
	gameOverDraw()
	-- windowFrameDraw()

	-- ghostDrawHitBox()
end

