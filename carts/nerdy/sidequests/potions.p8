pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--    side quest 3
-- alchemist's shelves

--from nerdy teachers course

--[[

   hello there, i already have
  a lot of potions, but i need
  shelves to display them!

   can you help me out?

   you can get as fancy as you
  want, and even spice up my
  shop's style by changing the
  wall paper and floors.

   i need all the potions to be
  on display, but if you want,
  you can move them around.

   (sign and potions in tab 1)

]]

--variables you can change
COLORS = { BLACK = 0, DARKBLUE = 1, MAGENTA = 2, DARKGREEN = 3, BROWN = 4, DARKGREY = 5, GREY = 6, WHITE = 7, RED = 8, ORANGE = 9, YELLOW = 10, NEONGREEN = 11, LIGHTBLUE = 12, LAVENDER = 13, PINK = 14, PEACH = 15 }
wall_color = COLORS.DARKGREEN
floor_color = COLORS.BROWN

-------shop background---------

--wall
cls(wall_color)

--floor
rectfill(0, 100, 127, 127, floor_color)

for i = 0, 50, 3 do
	random_color = { COLORS.BLACK, COLORS.PEACH }
	line(i * 3, 128, i * 3 + rnd(5) + 5, 100, random_color[flr(rnd(2) + 1)])
end

--base board
line(0, 100, 127, 100, 13)

--*** your shelves below ***--

-->8
--my potions

--[[

  i already have my sign and
 potions ready to go here.

  you can build shelves for
 them where they are now, or
 you can build the shelves how
 you want them and move the
 potions to fit them nicely.

]]

function _draw()
	--spr(sprite, x,y, width,height)

	-- carpet
	carpet = { x = 10, y = 105, width = 110, height = 20, color = COLORS.DARKGREEN }
	ovalfill(carpet.x, carpet.y, carpet.x + carpet.width, carpet.y + carpet.height, carpet.color)
	fillp(░)
	ovalfill(carpet.x + 5, carpet.y + 2, carpet.x + carpet.width - 5, carpet.y - 2 + carpet.height, COLORS.ORANGE)
	fillp()
	ovalfill(carpet.x + 20, carpet.y + 2, carpet.x + carpet.width - 20, carpet.y - 2 + carpet.height, COLORS.MAGENTA)
	fillp(✽)
	ovalfill(carpet.x + 30, carpet.y + 5, carpet.x + carpet.width - 30, carpet.y - 5 + carpet.height, COLORS.BLACK)

	--potions sign
	spr(64, 36, 2, 8, 4)

	--top row potions
	spr(0, 35, 35, 2, 2)
	spr(2, 45, 35, 2, 2)
	spr(4, 63, 35, 2, 2)
	spr(6, 80, 35, 2, 2)

	--second row
	spr(8, 35, 55, 2, 2)
	spr(10, 54, 55, 2, 2)
	spr(12, 63, 55, 2, 2)
	spr(14, 80, 55, 2, 2)

	--third row
	spr(32, 38, 75, 2, 2)
	spr(34, 52, 75, 2, 2)
	spr(36, 68, 75, 2, 2)
	spr(38, 80, 75, 2, 2)

	--fourth row
	spr(40, 33, 95, 2, 2)
	spr(42, 57, 95, 2, 2)
	spr(44, 65, 95, 2, 2)
	spr(46, 75, 95, 2, 2)
end

